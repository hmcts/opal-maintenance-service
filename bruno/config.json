{
  "version": "1.0",
  "name": "Opal Maintenance Service REST API Collection",
  "type": "workspace",
  "settings": {
    "requestTimeout": 30000,
    "followRedirects": true,
    "prettyPrintResponse": true
  },
  "request": {
    "ssl": {
      "validateSSL": true
    }
  },
  "envs": {
    "default": "local",
    "paths": [
      "./environments"
    ]
  }
}
