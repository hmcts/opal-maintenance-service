meta {
  name: Get maintenance applications
  type: http
  seq: 3
}

get {
  url: {{baseURL}}/maintenance-applications?application_group={{applicationGroup}}
  body: none
  auth: bearer
}

params:query {
  application_group: {{applicationGroup}}
  ~active: true
}

auth:bearer {
  token: {{BEARER_TOKEN}}
}

settings {
  encodeUrl: true
  timeout: 0
}
