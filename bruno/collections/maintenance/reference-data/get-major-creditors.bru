meta {
  name: Get major creditors
  type: http
  seq: 2
}

get {
  url: {{baseURL}}/major-creditors?business_unit_id={{businessUnitId}}
  body: none
  auth: bearer
}

params:query {
  business_unit_id: {{businessUnitId}}
  ~central_authority: true
  ~active: true
}

auth:bearer {
  token: {{BEARER_TOKEN}}
}

settings {
  encodeUrl: true
  timeout: 0
}
