#!groovy
import uk.gov.hmcts.contino.GithubAPI

@Library("Infrastructure@2.13.4")

def type = "java"
def product = "opal"
def component = "maintenance-service"

def configurePrUserService(String namespace) {
  env.DEV_ENABLE_OPAL_USER_SERVICE = false
  env.DEV_OPAL_USER_SERVICE_IMAGE_SUFFIX = 'latest'
  env.OPAL_USER_SERVICE_API_URL = 'https://opal-user-service.staging.platform.hmcts.net'
  env.DEV_ENABLE_OPAL_LOGGING_SERVICE = true
  env.DEV_OPAL_LOGGING_SERVICE_IMAGE_SUFFIX = 'latest'
  env.DEV_ENABLE_OPAL_SERVICE_BUS = true

  def githubApi = new GithubAPI(this)

  for (label in githubApi.getLabelsbyPattern(env.BRANCH_NAME, 'enable_opal_')) {
    if (label ==~ /enable_opal_user_service.*/) {
      env.DEV_ENABLE_OPAL_USER_SERVICE = true
      // The labelled User Service enables token-minting test support, so use only cluster DNS.
      env.OPAL_USER_SERVICE_API_URL =
        "http://opal-maintenance-service-pr-${env.CHANGE_ID}-user-service.${namespace}.svc.cluster.local"

      if (label ==~ /enable_opal_user_service:pr-.*/) {
        env.DEV_OPAL_USER_SERVICE_IMAGE_SUFFIX =
          label.replace('enable_opal_user_service:', '')
      }
    }
  }
}

def failBuildOnUnstableResults() {
  if (currentBuild.result == 'UNSTABLE') {
    currentBuild.result = 'FAILURE'
  }
}

def requireReport(String label, String directory) {
  if (!steps.fileExists("${directory}/index.html")) {
    throw new RuntimeException("${label} was not generated at ${directory}/index.html")
  }
}

def publishFunctionalResults(String environmentName) {
  failBuildOnUnstableResults()
  steps.archiveArtifacts allowEmptyArchive: true, artifacts: 'functional-output/**/*'
  requireReport('Functional report', 'functional-output/report')

  publishHTML target: [
      allowMissing         : false,
      alwaysLinkToLastBuild: true,
      keepAll              : true,
      reportDir            : 'functional-output/report',
      reportFiles          : 'index.html',
      reportName           : "Serenity Functional Test Report (${environmentName})"
  ]
}

def publishSmokeResults(String environmentName) {
  failBuildOnUnstableResults()
  steps.archiveArtifacts allowEmptyArchive: true, artifacts: 'smoke-output/**/*'
  requireReport('Smoke report', 'smoke-output/report')

  publishHTML target: [
      allowMissing         : false,
      alwaysLinkToLastBuild: true,
      keepAll              : true,
      reportDir            : 'smoke-output/report',
      reportFiles          : 'index.html',
      reportName           : "Serenity Smoke Test Report (${environmentName})"
  ]
}

withPipeline(type, product, component) {
  afterSuccess('build') {
    // Keep active Gradle downloads outside the workspace while ACR packages it.
    env.GRADLE_USER_HOME = "${env.WORKSPACE}@tmp/gradle-user-home"
  }

  if (!env.OPAL_USER_SERVICE_API_URL && !env.CHANGE_ID) {
    env.OPAL_USER_SERVICE_API_URL = 'https://opal-user-service.staging.platform.hmcts.net'
  }

  before('akschartsinstall') {
    onPR {
      configurePrUserService(product)
    }
  }

  afterAlways('test') {
    steps.junit allowEmptyResults: true, testResults: '**/test-results/integration/*.xml'
    failBuildOnUnstableResults()
    steps.archiveArtifacts allowEmptyArchive: true, artifacts: 'integration-output/**/*'
    requireReport('Integration report', 'integration-output/report')

    publishHTML target: [
        allowMissing         : false,
        alwaysLinkToLastBuild: true,
        keepAll              : true,
        reportDir            : 'integration-output/report',
        reportFiles          : 'index.html',
        reportName           : 'Integration Tests Report'
    ]
  }

  afterAlways('functionalTest:dev') {
    publishFunctionalResults('DEV')
  }

  afterAlways('smoketest:dev') {
    publishSmokeResults('DEV')
  }

  afterAlways('functionalTest:stg') {
    publishFunctionalResults('Staging')
  }

  afterAlways('smoketest:stg') {
    publishSmokeResults('Staging')
  }
}
